// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Image {
  id            String   @id @default(uuid())
  title         String?
  format        String?
  s3Key         String   @unique
  fileSize      Int?
  width         Int?
  height        Int?
  showOnLanding Boolean  @default(true)
  events        Event[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([s3Key])
}

model Video {
  id            String   @id @default(uuid())
  youtubeUrl    String?
  title         String?
  thumbnail     String?
  showOnLanding Boolean  @default(true)
  events        Event[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id          String    @id @default(uuid())
  title       String
  place       String?
  client      String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      Image[]
  videos      Video[]
}

model Service {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  eventOrder  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id          String   @id @default(uuid())
  referenceId String   @unique
  fullName    String
  phone       String
  address     String?
  content     String?
  status      String   @default("NEW") // NEW, CONTACTED, COMPLETED
  note        String?
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  logoKey   String? // S3 key for partner logo
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  RESPONDED
}

model Quote {
  id          String      @id @default(uuid())
  seq         Int         @unique @default(autoincrement()) // atomic counter for quoteNumber
  quoteNumber String      @unique // "BG-0059" = "BG-" + pad(seq, 4)
  token       String      @unique // public unguessable slug, e.g. "83ZRHCW"

  recipientName String
  status        QuoteStatus @default(DRAFT)

  // money — VND, integer (no decimals). Decimal(14,0) avoids Int4 overflow (~2.1B cap)
  subtotal  Decimal @db.Decimal(14, 0)
  discount  Decimal @default(0) @db.Decimal(14, 0)
  taxRate   Decimal @default(8) @db.Decimal(5, 2) // percent, e.g. 8.00
  taxAmount Decimal @db.Decimal(14, 0)
  total     Decimal @db.Decimal(14, 0)

  issueDate  DateTime  @db.Date
  validUntil DateTime? @db.Date

  // full nested document: sections[]->items[], blocks[], company snapshot, representative, feedback config
  content Json

  // customer response (price feedback on the public portal)
  customerFeedback String? // label of the option the customer picked
  feedbackComment  String? // optional free text, stored plain, rendered escaped
  respondedAt      DateTime?
  viewedAt         DateTime?
  respondentIp     String?

  representativeKey String? // S3 key of the issuer's signature image

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
